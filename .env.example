# Template only: replace every <placeholder> before starting services.
# See docs/ENVIRONMENT.md for non-sensitive defaults. Never overwrite an existing .env.
# Leave HF_TOKEN empty when model access is not needed.

# Application
APP_ENV=<application-environment>
API_HOST=<api-bind-address>
API_PORT=<api-port-number>
FRONTEND_URL=<comma-separated-allowed-frontend-origins>
HF_TOKEN=<optional-hugging-face-token-or-leave-empty>

# PostgreSQL (keep DATABASE_URL aligned with the values below)
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<choose-a-local-database-password>
POSTGRES_PORT=<postgres-host-port-number>
DATABASE_URL=<async-sqlalchemy-url-matching-your-postgres-settings>

# Exposed to browser code by Next.js when supplied to the web process.
NEXT_PUBLIC_API_URL=<browser-accessible-api-base-url>
